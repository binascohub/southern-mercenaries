msgid "TIP_REVIVE"
msgstr "An ally is down! Stay close and hold {button} to revive."

msgid "TIP_ELITE"
msgstr "Elite: stronger than the rest, but the loot is better."

msgid "TIP_BOSS"
msgstr "Boss! The bar at the top shows its health. It changes attacks between phases."

msgid "TIP_RETURN"
msgstr "Return portal: {button} takes the group back to Tortuga."

msgid "TIP_SHOP"
msgstr "Buy on the left, sell on the right. Shops pay little; valuables only with the pirates."

msgid "TIP_REFINE"
