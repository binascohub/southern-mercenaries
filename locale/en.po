msgstr "Sharp Mind"

msgid "SKILL_SHARP_MIND_DESC"
msgstr "Passive: +10% mana regeneration per rank."

msgid "SKILL_TELEPORT_NAME"
msgstr "Teleport"

msgid "SKILL_TELEPORT_DESC"
msgstr "Teleports up to 8 m toward your aim; passes through enemies, not walls. Cooldown -1 s per rank."

msgid "SKILL_MANA_SHIELD_NAME"
msgstr "Mana Shield"

msgid "SKILL_MANA_SHIELD_DESC"
msgstr "Passive: 20% of damage taken comes out of mana (+5% per rank); 1 mana absorbs 2 damage."

msgid "SKILL_ELEMENTAL_MASTERY_NAME"
msgstr "Elemental Mastery"

msgid "SKILL_ELEMENTAL_MASTERY_DESC"
msgstr "Passive: +6% damage and +10% state duration per rank."

msgid "SKILL_FIRE_BOLT_NAME"
msgstr "Fire Bolt"

msgid "SKILL_FIRE_BOLT_DESC"
msgstr "Fast projectile that sets the target burning."

msgid "SKILL_FIREBALL_NAME"
msgstr "Fireball"

msgid "SKILL_FIREBALL_DESC"
msgstr "Explodes on impact (3 m radius) and sets enemies burning."

msgid "SKILL_FLAME_BLESSING_NAME"
msgstr "Flame Blessing"

msgid "SKILL_FLAME_BLESSING_DESC"
msgstr "Allies within 8 m deal +15% damage (+3% per rank) and their hits burn, for 8 s."

msgid "SKILL_FIRE_LANCE_NAME"
msgstr "Fire Lance"

msgid "SKILL_FIRE_LANCE_DESC"
msgstr "Flaming lance that pierces one target; Melt combo on stunned enemies."

msgid "SKILL_FIRE_WALL_NAME"
msgstr "Fire Wall"

msgid "SKILL_FIRE_WALL_DESC"
msgstr "An 8 m line of fire for 6 s that burns everything crossing it."

msgid "SKILL_METEOR_NAME"
msgstr "Meteor"

msgid "SKILL_METEOR_DESC"
msgstr "Marks the ground and falls after 1.5 s (5 m radius); the ground burns for 4 s."

msgid "SKILL_WATER_BOLT_NAME"
msgstr "Water Jet"

msgid "SKILL_WATER_BOLT_DESC"
msgstr "Projectile that soaks the target."

msgid "SKILL_FROST_NOVA_NAME"
msgstr "Frost Nova"

msgid "SKILL_FROST_NOVA_DESC"
msgstr "Freezes enemies within 5 m for 2 s (+0.25 s per rank)."

msgid "SKILL_HEALING_RAIN_NAME"
msgstr "Healing Rain"

msgid "SKILL_HEALING_RAIN_DESC"
msgstr "For 6 s, heals allies within 5 m and soaks enemies there."

msgid "SKILL_ICE_LANCE_NAME"
msgstr "Ice Lance"

msgid "SKILL_ICE_LANCE_DESC"
msgstr "Ice lance; a soaked target is frozen for 2 s."

msgid "SKILL_TIDAL_WAVE_NAME"
msgstr "Tidal Wave"

msgid "SKILL_TIDAL_WAVE_DESC"
msgstr "An 8 m cone that pushes enemies back and soaks them."

msgid "SKILL_BLIZZARD_NAME"
msgstr "Blizzard"

msgid "SKILL_BLIZZARD_DESC"
msgstr "A 7 m storm for 6 s that slows; anyone inside for 3 s freezes."

msgid "SKILL_WIND_BLADE_NAME"
msgstr "Wind Blade"

msgid "SKILL_WIND_BLADE_DESC"
msgstr "Very fast, long-range projectile."

msgid "SKILL_CHAIN_LIGHTNING_NAME"
msgstr "Chain Lightning"

msgid "SKILL_CHAIN_LIGHTNING_DESC"
msgstr "Jumps between 5 enemies (+1 at ranks 3 and 5), -15% damage per jump; shocks."

msgid "SKILL_TAILWIND_NAME"
msgstr "Tailwind"

msgid "SKILL_TAILWIND_DESC"
msgstr "Allies within 8 m move and attack 30% faster (+5% per rank) for 8 s."

msgid "SKILL_LIGHTNING_BOLT_NAME"
msgstr "Lightning Bolt"

msgid "SKILL_LIGHTNING_BOLT_DESC"
msgstr "Strikes the target in your aim instantly and shocks it; electrocutes a soaked target."

msgid "SKILL_TORNADO_NAME"
msgstr "Tornado"

msgid "SKILL_TORNADO_DESC"
msgstr "Travels 10 m toward your aim for 5 s, pulling enemies into its center."

msgid "SKILL_STORM_NAME"
msgstr "Storm"

msgid "SKILL_STORM_DESC"
msgstr "For 8 s, lightning strikes a random enemy within 9 m every 0.5 s."

msgid "SKILL_STONE_BOLT_NAME"
msgstr "Stone Throw"

msgid "SKILL_STONE_BOLT_DESC"
msgstr "Slow, heavy projectile; 15% chance to stun."

msgid "SKILL_EARTH_SPIKES_NAME"
msgstr "Stone Spikes"

msgid "SKILL_EARTH_SPIKES_DESC"
msgstr "Spikes burst from the ground along 10 m and knock enemies down."

msgid "SKILL_STONE_SKIN_NAME"
msgstr "Stone Skin"

msgid "SKILL_STONE_SKIN_DESC"
msgstr "Shield on the most wounded ally within 10 m (or yourself) for 8 s."

msgid "SKILL_BOULDER_NAME"
msgstr "Crushing Boulder"

msgid "SKILL_BOULDER_DESC"
msgstr "A huge rock at one target that stuns it for 1.5 s."

msgid "SKILL_QUAKE_NAME"
