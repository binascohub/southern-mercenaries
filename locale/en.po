msgstr "Precise Shot"

msgid "SKILL_PRECISE_SHOT_DESC"
msgstr "Charged arrow that always lands a critical hit; carries your element's basic state."

msgid "SKILL_BACK_LEAP_NAME"
msgstr "Back Leap"

msgid "SKILL_BACK_LEAP_DESC"
msgstr "Leaps 6 m back; enemies within 4 m become 40% slower for 2 s. Cooldown -1 s per rank."

msgid "SKILL_EAGLE_EYE_NAME"
msgstr "Eagle Eye"

msgid "SKILL_EAGLE_EYE_DESC"
msgstr "Passive: +5% critical chance and +10% critical damage per rank."

msgid "SKILL_SPIKE_TRAP_NAME"
msgstr "Spike Trap"

msgid "SKILL_SPIKE_TRAP_DESC"
msgstr "A trap that roots whoever steps on it for 2 s (+0.25 s per rank) and hurts everyone within 3 m. Lasts 20 s; up to 3 on the ground."

msgid "SKILL_ARROW_FAN_NAME"
msgstr "Arrow Fan"

msgid "SKILL_ARROW_FAN_DESC"
msgstr "Fires 5 arrows in a fan (+1 at ranks 3 and 5)."

msgid "SKILL_PIERCING_ARROW_NAME"
msgstr "Piercing Arrow"

msgid "SKILL_PIERCING_ARROW_DESC"
msgstr "Goes through every enemy in a 25 m line."

msgid "SKILL_MARK_TARGET_NAME"
msgstr "Mark Target"

msgid "SKILL_MARK_TARGET_DESC"
msgstr "The target in your aim takes +15% damage (+3% per rank) from the whole group for 8 s."

msgid "SKILL_HUNTERS_CAMPFIRE_NAME"
msgstr "Hunter's Campfire"

msgid "SKILL_HUNTERS_CAMPFIRE_DESC"
msgstr "An arrow lights a campfire for 8 s; allies within 6 m deal +15% damage (+3% per rank) and their hits burn."

msgid "SKILL_FLAMING_ARROW_NAME"
msgstr "Flaming Arrow"

msgid "SKILL_FLAMING_ARROW_DESC"
msgstr "Burning arrow; its burn deals double damage."

msgid "SKILL_FIRE_RAIN_NAME"
msgstr "Rain of Fire"

msgid "SKILL_FIRE_RAIN_DESC"
msgstr "Flaming arrows fall over a 6 m area for 5 s and set the ground on fire."

msgid "SKILL_SPRING_ARROW_NAME"
msgstr "Spring Arrow"

msgid "SKILL_SPRING_ARROW_DESC"
msgstr "An arrow opens a 5 m spring for 6 s that heals allies and soaks enemies."

msgid "SKILL_FROST_ARROW_NAME"
msgstr "Frost Arrow"

msgid "SKILL_FROST_ARROW_DESC"
msgstr "Ice arrow; a soaked target is frozen for 2 s."

msgid "SKILL_HAIL_STORM_NAME"
msgstr "Hailstorm"

msgid "SKILL_HAIL_STORM_DESC"
msgstr "Hail over a 7 m area for 6 s; slows, and anyone inside for 3 s freezes."

msgid "SKILL_HUNTERS_WIND_NAME"
msgstr "Hunter's Wind"

msgid "SKILL_HUNTERS_WIND_DESC"
msgstr "Allies within 8 m move and attack 30% faster (+5% per rank) for 8 s."

msgid "SKILL_THUNDER_ARROW_NAME"
msgstr "Thunder Arrow"

msgid "SKILL_THUNDER_ARROW_DESC"
msgstr "Strikes like lightning and shocks; electrocutes a soaked target."

msgid "SKILL_STORM_VOLLEY_NAME"
msgstr "Storm Volley"

msgid "SKILL_STORM_VOLLEY_DESC"
