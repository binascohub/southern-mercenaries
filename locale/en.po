msgid "SKILL_BULWARK_ARROW_NAME"
msgstr "Bulwark Arrow"

msgid "SKILL_BULWARK_ARROW_DESC"
msgstr "Stones rise around you and shield allies within 5 m for 8 s."

msgid "SKILL_BOULDER_ARROW_NAME"
msgstr "Rockbreaker Arrow"

