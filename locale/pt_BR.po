msgstr "Aperte {button} para falar, abrir portas e usar o que estiver perto."

msgid "TIP_ATTACK"
msgstr "Um monstro acordou. Aperte {button} para atacar."

msgid "TIP_CHARGED"
msgstr "Segure {button} e solte para um golpe forte."

msgid "TIP_SKILL"
msgstr "Recurso cheio: use sua habilidade com {button}. Ela gasta recurso e entra em recarga."

msgid "TIP_DODGE"
