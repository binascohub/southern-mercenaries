msgid "QUEST_CE_LUNGS"
msgstr "Os Pulmões do Coveiro"

msgid "QUEST_CE_LUNGS_DESC"
msgstr "O Coveiro Abel quer os Pulmões Humanos que o Ogro da Cripta carrega. Pegue o livro com ele, desperte o Ogro no altar da alameda e traga os pulmões; ele entrega a Chave do Ossuário."

msgid "QUEST_CE_LANTERN"
msgstr "A Lamparina do Sentinela"

msgid "QUEST_CE_LANTERN_DESC"
