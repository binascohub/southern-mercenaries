msgid "DLG_CEWARD_3"
msgstr "Os mini-chefes esperam no altar da alameda. Sem eles, não há chaves."

msgid "DLG_CEWARD_ACTIVE"
msgstr "Ainda faltam chaves. Falem com o Coveiro e com a Zeladora."

msgid "DLG_CEWARD_DONE"
