msgid "LEGENDARY_ROYAL_COUNCILOR_STAFF_LORE"
msgstr "Do arsenal real do reino que perdeu a guerra. Ainda guarda o calor de quem aconselhava o rei."

msgid "LEGENDARY_ROYAL_GUARD_BOW"
msgstr "Arco da Guarda Real"

msgid "LEGENDARY_ROYAL_GUARD_BOW_LORE"
msgstr "A águia sobre três flechas ainda está entalhada no punho. A guarda caiu; o arco, não."

msgid "LEGENDARY_STANDARD_BEARER_LANCE"
msgstr "Lança do Porta-Estandarte"

msgid "LEGENDARY_STANDARD_BEARER_LANCE_LORE"
msgstr "Carregou a bandeira do reino até a última batalha. Um pedaço do pano ainda está preso nela."

msgid "LEGENDARY_TREASURER_DAGGERS"
msgstr "Adagas do Tesoureiro"

msgid "LEGENDARY_TREASURER_DAGGERS_LORE"
msgstr "O tesoureiro do rei guardava o ouro com elas. Ironia: agora servem a um ladrão."

msgid "LEGENDARY_ROYAL_STABLES_BOOK"
