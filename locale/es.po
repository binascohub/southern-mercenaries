msgstr "Reptil del Bosque"

msgid "MONSTER_RUIN_WARDEN"
msgstr "Guardián de la Cámara"

msgid "MONSTER_CRYPT_SCORPION"
msgstr "Ogro de la Cripta"

msgid "MONSTER_CRYPT_LORD"
msgstr "Señor de la Cripta"

msgid "MONSTER_FORT_COMMANDER"
msgstr "Comandante Maldito"

msgid "MONSTER_DARK_ELF"
