msgid "SIGN_WAR_CREST"
msgstr "Un escudo gastado en la pared: un águila sobre tres flechas. Alguien cavó este túnel con prisa."

msgid "SIGN_WAR_CREST_ARCHER"
msgstr "El escudo de mi reino. Así que por aquí huyó el tesoro de la guerra."

msgid "HUD_VICTORY_SEWERS"
msgstr "El Hechicero Araña ha caído."

msgid "HUD_VICTORY_TREASURE"
msgstr "El Tesoro Perdido de la Guerra está abierto para el grupo."

