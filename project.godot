; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Southern Mercenaries"
config/description="Co-op LAN action RPG"
config/version="0.1.0"
run/main_scene="res://game/main/main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="southern-mercenaries"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/custom_user_dir_name.windows="Southern Mercenaries"

[autoload]

Settings="*res://game/autoload/settings.gd"
Controls="*res://game/autoload/controls.gd"
InputDevice="*res://game/autoload/input_device.gd"
GameData="*res://game/autoload/game_data.gd"
NetworkManager="*res://game/autoload/network_manager.gd"
SaveSystem="*res://game/autoload/save_system.gd"
Session="*res://game/autoload/session.gd"
TipManager="*res://game/autoload/tip_manager.gd"
Sfx="*res://game/autoload/sfx.gd"
Music="*res://game/autoload/music.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[internationalization]

locale/translations=PackedStringArray("res://locale/en.po", "res://locale/es.po", "res://locale/pt_BR.po")

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="players"
3d_physics/layer_3="enemies"
3d_physics/layer_4="player_projectiles"
3d_physics/layer_5="ponds"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
